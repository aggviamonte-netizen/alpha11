{
  "name": "alpha11",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "wrangler types worker/worker-configuration.d.ts && tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "tsx --test worker/test/api.test.ts",
