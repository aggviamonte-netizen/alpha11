    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "phaser": "^3.88.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "vite": "^6.3.5",
    "wrangler": "^4.40.0"
  }
}
